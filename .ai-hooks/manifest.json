{
  "_comment": "SSOT for AI/Codex hook registry — 人写这个,scripts/regen_settings.py 生成 .ai-config/settings.json{,.template}。改 hook 注册只动这个文件。",
  "model": "gpt-5-codex",
  "base_url": "",
  "enabledPlugins": {
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "permissions": {
    "allow": [
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      "rule_activator.sh"
    ],
    "PreToolUse_Bash": [
      "dangerous_bash.sh",
      "git_commit_safety.sh"
    ],
    "PreToolUse_EditWriteMultiEdit": [
      "exploration_gate.sh"
    ],
    "PostToolUse_EditWriteMultiEdit": [
      "engineering_audit.sh",
      "rename_audit.sh",
      "rag_hygiene.sh",
      "rag_drift.sh"
    ]
  }
}
