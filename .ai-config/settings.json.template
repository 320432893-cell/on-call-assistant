{
  "env": {
    "OPENAI_API_KEY": "REPLACE_ME_WITH_YOUR_TOKEN"
  },
  "model": "gpt-5-codex",
  "permissions": {
    "allow": [
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .ai-hooks/rule_activator.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .ai-hooks/dangerous_bash.sh"
          },
          {
            "type": "command",
            "command": "bash .ai-hooks/git_commit_safety.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .ai-hooks/exploration_gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .ai-hooks/engineering_audit.sh"
          },
          {
            "type": "command",
            "command": "bash .ai-hooks/rename_audit.sh"
          },
          {
            "type": "command",
            "command": "bash .ai-hooks/rag_hygiene.sh"
          },
          {
            "type": "command",
            "command": "bash .ai-hooks/rag_drift.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  }
}
