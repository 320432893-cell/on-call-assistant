{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "REPLACE_ME_WITH_YOUR_TOKEN",
    "ANTHROPIC_BASE_URL": "https://cdn.codeflow.asia"
  },
  "model": "claude-opus-4-7",
  "permissions": {
    "allow": [
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/rule_activator.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/dangerous_bash.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/git_commit_safety.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/engineering_audit.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/rename_audit.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/first_iter_lines.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/playwright_no_sleep.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/http_timeout.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/fastapi_debug.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/rag_hygiene.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/rag_drift.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/ml_timeseries.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  }
}
