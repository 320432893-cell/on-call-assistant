[importlinter]
include_external_packages = True
root_packages =
    app

# === 契约: 分层架构 (DIP) ===
# 强制 routers > services > core > models > config 单向依赖
# 任何反向 import (config 不许 import models 等) 会被拦截
# 这是 code.md § 1 DIP 规则的物理实施
[importlinter:contract:layers]
name = Layered architecture: routers > services > core > models > config
type = layers
layers =
    app.routers
    app.services
    app.core
    app.models
    app.config

[importlinter:contract:models-no-framework]
name = Models stay independent from transport, UI, and external IO frameworks
type = forbidden
source_modules =
    app.models
forbidden_modules =
    fastapi
    starlette
    jinja2
    typer
    click
    requests
    httpx
    openai
    anthropic
    google
    google_genai
    qdrant_client
    redis
    tantivy

[importlinter:contract:config-no-runtime-io]
name = Config stays independent from transport, UI, and external IO clients
type = forbidden
source_modules =
    app.config
forbidden_modules =
    fastapi
    starlette
    jinja2
    requests
    httpx
    openai
    anthropic
    google
    google_genai
    qdrant_client
    redis
    tantivy
