REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=1800

TANTIVY_INDEX_PATH=./indexes/tantivy
QDRANT_PATH=./indexes/qdrant
QDRANT_COLLECTION=sop_documents

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# LLM Provider 主开关：anthropic | openai_compat | gemini
LLM_PROVIDER=openai_compat

# OpenAI 兼容（覆盖 OpenAI / DeepSeek / 通义 / Kimi / 豆包 / 智谱 等）
LLM_BASE_URL=https://Chat.heroai.icu
LLM_API_KEY=
LLM_MODEL=claude-opus-4-6

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Agent 控制
AGENT_MAX_STEPS=6
AGENT_STATE_TIMEOUT=300
AGENT_TOOL_TIMEOUT=10
AGENT_GENERATE_TIMEOUT=60
